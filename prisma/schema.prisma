generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  SCHEDULED
  PROCESSING
  COMPLETED
  PAUSED
  FAILED
}

enum JobStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  RESCHEDULED
}

enum SenderProvider {
  ETHEREAL
}

enum SenderStatus {
  PENDING
  ACTIVE
  FAILED
  DISABLED
}

model User {
  id            String   @id @default(uuid())
  googleSubject String?  @unique @map("google_subject")
  email         String   @unique
  passwordHash  String?  @map("password_hash")
  name          String
  avatarUrl     String?  @map("avatar_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  slackIntegration SlackIntegration?
  campaigns        EmailCampaign[]
  senderAccounts   SenderAccount[]
  refreshSessions  RefreshSession[]

  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")

  @@index([userId])
  @@map("refresh_sessions")
}

model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String   @map("access_token")
  botUserId   String?  @map("bot_user_id")
  teamId      String?  @map("team_id")
  teamName    String?  @map("team_name")
  channelId   String?  @map("channel_id")
  webhookUrl  String?  @map("webhook_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("slack_integrations")
}

model SenderAccount {
  id                    String         @id @default(uuid())
  userId                String         @map("user_id")
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String         @map("display_name")
  email                 String?
  avatarUrl             String?        @map("avatar_url")
  provider              SenderProvider @default(ETHEREAL)
  smtpHost              String?        @map("smtp_host")
  smtpPort              Int?           @map("smtp_port")
  smtpUsername          String?        @map("smtp_username")
  smtpPasswordEncrypted String?        @map("smtp_password_encrypted")
  smtpSecure            Boolean        @default(false) @map("smtp_secure")
  status                SenderStatus   @default(PENDING)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  userCampaigns         EmailCampaign[]

  @@index([userId])
  @@index([userId, status])
  @@map("sender_accounts")
}

model EmailCampaign {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId          String?        @map("sender_id")
  sender            SenderAccount? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  title             String
  subject           String
  body              String         @db.Text
  startTime         DateTime       @map("start_time")
  delayBetweenSends Int            @default(2) @map("delay_between_sends") // in seconds
  hourlyLimit       Int            @default(200) @map("hourly_limit")
  totalRecipients   Int            @default(0) @map("total_recipients")
  status            CampaignStatus @default(SCHEDULED)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  emailJobs         EmailJob[]

  @@map("email_campaigns")
}

model EmailJob {
  id             String        @id @default(uuid())
  campaignId     String        @map("campaign_id")
  campaign       EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  idempotencyKey String        @unique @map("idempotency_key")
  senderEmail    String        @map("sender_email")
  recipientEmail String        @map("recipient_email")
  subject        String
  body           String        @db.Text
  scheduledFor   DateTime      @map("scheduled_for")
  sentAt         DateTime?     @map("sent_at")
  status         JobStatus     @default(PENDING)
  bullJobId      String?       @map("bull_job_id")
  errorMessage   String?       @map("error_message")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([campaignId])
  @@index([status])
  @@index([scheduledFor])
  @@index([senderEmail])
  @@map("email_jobs")
}
